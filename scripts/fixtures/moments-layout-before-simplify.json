{
  "screens": {
    "moments-compose-screen": "<div id=\"moments-compose-screen\" class=\"screen moments-screen\">\n            <header class=\"moments-header\">\n                <button type=\"button\" class=\"moments-icon-btn back-btn\" data-target=\"moments-screen\" aria-label=\"取消\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"></path></svg></button>\n                <h1 id=\"moments-compose-title\">发布动态</h1>\n                <button type=\"button\" class=\"moments-publish-btn\" id=\"moments-publish-btn\">发布</button>\n            </header>\n            <main class=\"moments-scroll moments-compose-content\">\n                <div class=\"moments-author-line\" id=\"moments-compose-author\"></div>\n                <label class=\"moments-field moments-compose-persona-field\">以哪个身份发布<select id=\"moments-compose-persona\"></select></label>\n                <div class=\"moments-compose-kind\" role=\"group\" aria-label=\"发布类型\">\n                    <button type=\"button\" data-kind=\"post\" class=\"active\">动态</button>\n                    <button type=\"button\" data-kind=\"story\">24 小时 Story</button>\n                </div>\n                <textarea id=\"moments-compose-text\" placeholder=\"这一刻，想分享什么？\" maxlength=\"5000\"></textarea>\n                <div id=\"moments-compose-mentions\" class=\"moments-mention-suggestions\" hidden=\"\"></div>\n                <div id=\"moments-compose-media\" class=\"moments-compose-media\"></div>\n                <div class=\"moments-compose-tools\">\n                    <button type=\"button\" id=\"moments-image-btn\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"></circle><path d=\"M21 15l-5-5L5 21\"></path></svg><span>图片</span></button>\n                    <button type=\"button\" id=\"moments-video-btn\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"23 7 16 12 23 17 23 7\"></polygon><rect x=\"1\" y=\"5\" width=\"15\" height=\"14\" rx=\"2\" ry=\"2\"></rect></svg><span>视频</span></button>\n                    <button type=\"button\" id=\"moments-audio-btn\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18V5l12-2v13\"></path><circle cx=\"6\" cy=\"18\" r=\"3\"></circle><circle cx=\"18\" cy=\"16\" r=\"3\"></circle></svg><span>音频</span></button>\n                    <button type=\"button\" id=\"moments-record-btn\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"23\"></line><line x1=\"8\" y1=\"23\" x2=\"16\" y2=\"23\"></line></svg><span>录音</span></button>\n                    <button type=\"button\" id=\"moments-compose-sticker-btn\" aria-label=\"添加表情包\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M8 14c1 2 2.4 3 4 3s3-1 4-3\"></path><circle cx=\"9\" cy=\"10\" r=\"1\" fill=\"currentColor\" stroke=\"none\"></circle><circle cx=\"15\" cy=\"10\" r=\"1\" fill=\"currentColor\" stroke=\"none\"></circle></svg><span>表情包</span></button>\n                </div>\n                <input id=\"moments-media-input\" type=\"file\" hidden=\"\">\n                <div class=\"moments-compose-options\">\n                    <button type=\"button\" id=\"moments-audience-btn\"><span>谁可以看</span><span id=\"moments-audience-label\">仅自己　›</span></button>\n                    <button type=\"button\" id=\"moments-remind-btn\"><span>提醒谁看</span><span id=\"moments-remind-label\">选择角色　›</span></button>\n                    <label class=\"moments-field moments-view-choice\">这条动态何时让提醒的人看<select id=\"moments-compose-view-mode\"><option value=\"default\">按动态设置</option><option value=\"now\">马上观看</option><option value=\"later\">过段时间观看</option></select></label>\n                </div>\n                <p class=\"moments-hint\">马上观看只对“提醒谁看”的对象生效。@ 不会改变可见范围。</p>\n            </main>\n        </div>",
    "moments-settings-screen": "<div id=\"moments-settings-screen\" class=\"screen moments-screen\">\n            <header class=\"moments-header\"><button type=\"button\" class=\"moments-icon-btn back-btn\" data-target=\"moments-screen\" aria-label=\"返回\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"></path></svg></button><h1>动态设置</h1><span class=\"moments-header-spacer\"></span></header>\n            <main class=\"moments-scroll moments-settings-content\">\n                <section class=\"moments-settings-card\"><h2>动态名字</h2><label class=\"moments-field\">角色未设置网名时显示<select id=\"moments-character-name-source\"><option value=\"remark\">角色备注</option><option value=\"real\">真名</option></select></label><p class=\"moments-hint\">点击个人主页上的名字，可为角色、人脉或当前用户身份设置独立的动态网名。</p></section>\n                <section class=\"moments-settings-card\"><h2>网名互动</h2><div class=\"moments-nickname-switches\"><label><span>角色感知网名</span><input type=\"checkbox\" id=\"moments-character-nickname-awareness\"></label><label><span>人脉感知网名</span><input type=\"checkbox\" id=\"moments-contact-nickname-awareness\"></label><label><span>角色自主修改网名</span><input type=\"checkbox\" id=\"moments-character-self-rename\"></label><label><span>人脉自主修改网名</span><input type=\"checkbox\" id=\"moments-contact-self-rename\"></label></div><p class=\"moments-hint\">仅允许修改自己的动态网名，自主改名最多每天一次。具体角色和人脉可单独选择允许或禁止。</p></section>\n                <section class=\"moments-settings-card\"><h2>互动可见范围</h2><label class=\"moments-field\">谁能看见点赞和评论<select id=\"moments-interaction-visibility\"><option value=\"mutual\">共同人脉可见</option><option value=\"all\">所有可看帖的人可见</option></select></label><p class=\"moments-hint\">发帖者始终能看到自己动态下的全部互动。</p></section>\n                <section class=\"moments-settings-card\"><h2>观看默认方式</h2><label class=\"moments-field\">提醒谁看之后<select id=\"moments-default-view-mode\"><option value=\"now\">马上观看</option><option value=\"later\">过段时间观看</option></select></label><p class=\"moments-hint\">单条动态的选择优先于这里。</p></section>\n                <section class=\"moments-settings-card\"><h2>可见分组</h2><div id=\"moments-groups-list\"></div><div class=\"moments-inline-actions\"><button type=\"button\" id=\"moments-add-group-btn\">＋ 新建分组</button></div><p class=\"moments-hint\">分组只包含聊天角色。发布时会保存当时选中的角色名单。</p></section>\n                <section class=\"moments-settings-card\"><h2>角色认识我的身份</h2><div id=\"moments-identity-bindings\"></div><p class=\"moments-hint\">发动态时按这里的人设区分可见身份；未指定的角色沿用当前展示档案。</p></section>\n                <section class=\"moments-settings-card\"><h2>动态管理</h2><p class=\"moments-hint\">搜索、按发布人筛选，或多选清除动态与 Story。</p><div class=\"moments-inline-actions\"><button type=\"button\" id=\"moments-manage-btn\">管理动态</button></div></section>\n                <section class=\"moments-settings-card\"><h2>主动动态</h2><p class=\"moments-hint\">角色及人脉的能力开关在对应角色的聊天设置中管理。额外调用、发布时间和评论接话在下方单独设置；AI 可以选择不行动。</p><button type=\"button\" id=\"moments-generate-now-btn\">检查一次自主动态</button><div class=\"moments-inline-actions\"><button type=\"button\" id=\"moments-controls-btn\">调用与互动设置</button></div></section>\n            </main>\n        </div>",
    "moments-result-dialog": "<div id=\"moments-result-dialog\" class=\"moments-picker moments-centered-dialog\" hidden=\"\"><div class=\"moments-picker-shade\" data-action=\"close-result\"></div><div class=\"moments-editor-panel\"><h2>本次观看结果</h2><div id=\"moments-result-content\"></div><div class=\"moments-inline-actions\"><button type=\"button\" data-action=\"close-result\">关闭</button></div></div></div>"
  },
  "roleGroup": "<div class=\"kkt-group\" style=\"margin-top:15px;\">\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">动态与人脉<p class=\"kkt-item-hint\">在 VOOM 风格动态页中使用，默认关闭</p></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">角色主动发动态</div><div class=\"kkt-item-control\"><label class=\"kkt-switch\"><input type=\"checkbox\" id=\"setting-moments-post-enabled\"><span class=\"kkt-slider\"></span></label></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">角色主动发 Story</div><div class=\"kkt-item-control\"><label class=\"kkt-switch\"><input type=\"checkbox\" id=\"setting-moments-story-enabled\"><span class=\"kkt-slider\"></span></label></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">角色自主刷动态</div><div class=\"kkt-item-control\"><label class=\"kkt-switch\"><input type=\"checkbox\" id=\"setting-moments-browse-enabled\"><span class=\"kkt-slider\"></span></label></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">角色点赞评论</div><div class=\"kkt-item-control\"><label class=\"kkt-switch\"><input type=\"checkbox\" id=\"setting-moments-interact-enabled\"><span class=\"kkt-slider\"></span></label></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">启用角色人脉</div><div class=\"kkt-item-control\"><label class=\"kkt-switch\"><input type=\"checkbox\" id=\"setting-moments-contacts-enabled\"><span class=\"kkt-slider\"></span></label></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">显示动态操作旁白<p class=\"kkt-item-hint\">默认隐藏，角色仍能记住</p></div><div class=\"kkt-item-control\"><label class=\"kkt-switch\"><input type=\"checkbox\" id=\"setting-moments-show-activity-narration\"><span class=\"kkt-slider\"></span></label></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">感知动态网名</div><div class=\"kkt-item-control\"><select id=\"setting-moments-nickname-awareness\"><option value=\"inherit\">跟随动态设置</option><option value=\"on\">允许</option><option value=\"off\">禁止</option></select></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">自主修改动态网名</div><div class=\"kkt-item-control\"><select id=\"setting-moments-self-rename\"><option value=\"inherit\">跟随动态设置</option><option value=\"on\">允许</option><option value=\"off\">禁止</option></select></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">动态图片</div><div class=\"kkt-item-control\"><select id=\"setting-moments-image-mode\"><option value=\"off\">不生成</option><option value=\"manual\">按需生成</option><option value=\"auto\">自动生成</option><option value=\"ai\">AI 决定</option></select></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">动态语音</div><div class=\"kkt-item-control\"><select id=\"setting-moments-voice-mode\"><option value=\"off\">不生成</option><option value=\"manual\">按需生成</option><option value=\"auto\">自动生成</option><option value=\"ai\">AI 决定</option></select></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">角色人脉</div><div class=\"kkt-item-control\"><button type=\"button\" id=\"setting-moments-contacts-btn\" class=\"btn btn-small btn-secondary\">管理人脉</button></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">调用、发布与评论设置<p class=\"kkt-item-hint\">后台调用需单独开启，间隔和接话均可自定义</p></div><div class=\"kkt-item-control\"><button type=\"button\" id=\"setting-moments-controls-btn\" class=\"btn btn-small btn-secondary\">设置</button></div></div>\n                                <div class=\"kkt-item\"><div class=\"kkt-item-label\">生成一条角色动态</div><div class=\"kkt-item-control\"><button type=\"button\" id=\"setting-moments-generate-btn\" class=\"btn btn-small btn-secondary\">现在生成</button></div></div>\n                            </div>"
}
